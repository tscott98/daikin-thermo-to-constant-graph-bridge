    {
      "id": 20,
      "title": "Refrigerant circuit temperatures",
      "type": "timeseries",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_INFINITY}"
      },
      "description": "The shape matters more than the values. Discharge well above coil, coil above ambient, suction coldest. A convergence between discharge and suction suggests the compressor is not pumping.",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_INFINITY}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "/api/series?from=$__from&to=$__to&interval=$__interval_ms&device=$device&fields=sp_discharge_temp_f,sp_od_coil_temp_f,sp_od_liquid_temp_f,sp_suction_temp_f,sp_eev_suction_temp_f",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "sp_discharge_temp_f",
              "text": "Discharge",
              "type": "number"
            },
            {
              "selector": "sp_od_coil_temp_f",
              "text": "Outdoor coil",
              "type": "number"
            },
            {
              "selector": "sp_od_liquid_temp_f",
              "text": "Liquid line",
              "type": "number"
            },
            {
              "selector": "sp_suction_temp_f",
              "text": "Suction",
              "type": "number"
            },
            {
              "selector": "sp_eev_suction_temp_f",
              "text": "Indoor coil suction",
              "type": "number"
            }
          ],
          "filters": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 6
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Discharge"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Outdoor coil"
