  "uid": "daikin-health",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "name": "Config changes",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [
            "daikin",
            "config-change"
          ],
          "type": "tags"
        }
      }
    ]
  },
  "title": "Daikin \u2014 System Health & Diagnostics",
  "description": "Whether anything is wrong or slowly getting worse. Defaults to 14 days so slow trends are visible; widen to months for superheat.",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "daikin",
    "health"
  ],
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Device ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Optional. Blank for all thermostats; IDs from /api/stats.",
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "title": "Outdoor critical",
      "type": "stat",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_INFINITY}"
      },
      "description": "0 is healthy. Any other value is an equipment fault code.",
