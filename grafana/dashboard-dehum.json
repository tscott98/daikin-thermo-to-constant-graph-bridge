    {
      "id": 9,
      "title": "Condensing margin",
      "type": "timeseries",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_INFINITY}"
      },
      "description": "Supply dry bulb minus return dew point. Negative means condensation is visible at the probe. A small positive value is expected while the coil is still condensing, because duct gain warms the air before it reaches the register - so read the trend, not the sign. This is the honest version of the SHR question: with no humidity sensor at the supply, shr_est bottoms out at 1.0 whenever the probe cannot see condensation.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "targets": [
        {
          "refId": "A",
