      "type": "timeseries",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_INFINITY}"
      },
      "description": "From the thermostat's outdoor feed. The EPA 8-hour standard is 70 ppb. On high-ozone days the useful response is minimising outside air, since a particulate filter does not remove ozone.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
