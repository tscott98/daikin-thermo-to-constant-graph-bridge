          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "/api/series?from=$__from&to=$__to&interval=$__interval_ms&device=$device&fields=sp_aq_outdoor_ozone",
          "url_options": {
            "method": "GET"
