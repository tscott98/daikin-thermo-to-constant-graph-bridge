    {
      "id": 6,
      "title": "Room vs thermostat - temperature and humidity",
      "type": "timeseries",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_INFINITY}"
      },
      "description": "Two independent sensors in different places. Bound to the window the bridge has been running, because it needs thermostat data; the panel below covers the sensor's full history. The room reads several degrees warmer than the thermostat, which matters because at equal moisture the cooler location reports the higher relative humidity. Compare ag_w_gr against indoor_w_gr on the dehumidification dashboard to see moisture without that confound.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_INFINITY}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "/api/series?from=$__from&to=$__to&interval=$__interval_ms&device=$device&fields=ag_temp_f,indoor_f,ag_rh,hum_indoor",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "",
          "columns": [
