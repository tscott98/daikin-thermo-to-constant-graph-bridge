            "uid": "${DS_INFINITY}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "/api/air?from=$__from&to=$__to&interval=$__interval_ms&fields=ag_tvoc_index_max,ag_nox_index_max",
          "url_options": {
            "method": "GET"
